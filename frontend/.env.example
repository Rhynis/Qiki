# Server-side backend origin for Next.js rewrites and server components.
BACKEND_URL=http://localhost:8000

# Browser API calls use same-origin /api via the Next.js proxy.
# Leave empty or unset in production.
NEXT_PUBLIC_API_URL=

# Supabase project URL used by browser-side auth helpers.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. This is safe to expose to the browser when RLS policies are correct.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opt into the LangGraph agent chat window instead of the default RAG chat.
# Mirrors the backend AGENT_ENABLED flag (default off) — see docs/adr/0001.
NEXT_PUBLIC_AGENT_ENABLED=
