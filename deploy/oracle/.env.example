# Copy to deploy/oracle/.env on the VPS and fill with the SAME values used on the other hosts.
# NEVER commit the real .env. JWT_SECRET_KEY must be identical on every host (see docs/HOSTING.md).
ENVIRONMENT=production
LLM_PROVIDER=gemini
EMAIL_PROVIDER=smtp

# Shared infra (same as Railway/Render)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/postgres
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
JWT_SECRET_KEY=THE-SAME-SECRET-ON-EVERY-HOST
FRONTEND_URL=https://gas-rag-bot-rhynis-projects.vercel.app
CORS_ORIGINS=https://gas-rag-bot-rhynis-projects.vercel.app

# Providers
GEMINI_API_KEY=
GEMINI_USE_VERTEX=false
GROQ_API_KEY=
JINA_API_KEY=

# Email (Gmail SMTP)
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Gas Quốc Cường <your-gmail@gmail.com>

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
