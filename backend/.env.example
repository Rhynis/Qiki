# Gemini / Vertex AI
# GEMINI_API_KEY also enables the optional DeepEval LLM judge (tests/eval, -m judge);
# no new secret — it reuses this chatbot key. Empty here -> judged evals skip.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Jina embedding fallback
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3

# Transactional email — provider is "smtp" (Gmail App Password) or "resend"
EMAIL_PROVIDER=smtp
EMAIL_FROM="Gas Quốc Cường <onboarding@resend.dev>"
FRONTEND_URL=http://localhost:3000
# Resend (alternative provider; needs a verified domain to reach any recipient)
RESEND_API_KEY=
# Gmail SMTP — create a Google App Password; never commit a real password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Infrastructure (shared across all backend hosts — keep identical; see docs/HOSTING.md)
# DATABASE_URL: Supabase pooler (postgresql+asyncpg://...)
# REDIS_URL: local redis:// or an Upstash rediss://... (TLS) URL — redis-py supports rediss://
# JWT_SECRET_KEY: MUST be identical on every host, or switching hosts logs everyone out
DATABASE_URL=
REDIS_URL=
JWT_SECRET_KEY=
